# Copy this file to .env and fill in real values before running docker-compose up.

# Shown in the page title and header.
PARTY_NAME=Winter LAN 2026

# Shared password everyone types to get into the app.
PARTY_PASSWORD=change-me

# Random secret used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too
